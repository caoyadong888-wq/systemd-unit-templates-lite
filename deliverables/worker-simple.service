# /etc/systemd/system/worker-simple.service
# Install: sudo cp worker-simple.service /etc/systemd/system/
#          sudo systemctl daemon-reload && sudo systemctl enable --now worker-simple.service
#
# Type=simple is the default for a long-running process that stays in the
# foreground. systemd considers the service started as soon as ExecStart
# forks the main process. Do not fork or double-fork in the program.

[Unit]
Description=Worker process (simple, long-running)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 -m worker --config /etc/worker/worker.toml
Restart=on-failure
RestartSec=2s
TimeoutStopSec=30s
KillSignal=SIGTERM

# Hardening
# User: create a dedicated account and replace root.
#   useradd --system --home /var/lib/worker --shell /usr/sbin/nologin worker
#   User=worker
#   Group=worker
# Do not set User=nobody. systemd-analyze reports that special user as unsafe.
User=root
Group=root
# NoNewPrivileges: the process cannot gain privileges through setuid or file capabilities.
NoNewPrivileges=yes
# ProtectSystem=strict: /usr, /boot, and /etc are read-only for this process.
# The Python module still reads the interpreter under /usr (read-only is enough).
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
StateDirectory=worker
LogsDirectory=worker
RuntimeDirectory=worker
ReadWritePaths=/var/lib/worker /var/log/worker
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
