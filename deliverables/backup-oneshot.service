# /etc/systemd/system/backup-oneshot.service
# Install: sudo cp backup-oneshot.service /etc/systemd/system/
#          sudo systemctl daemon-reload
#          sudo systemctl start backup-oneshot.service
#
# Type=oneshot runs ExecStart once and then exits. Use it for backups,
# imports, and other jobs that are not long-running processes.
# Pair it with report-daily.timer when it should run on a calendar.

[Unit]
Description=Database backup (oneshot)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Replace with the real backup program. systemd-analyze verify reports
# "not executable" until that path exists.
ExecStart=/usr/local/sbin/backup-db --config /etc/backup-db/backup.conf
RemainAfterExit=no
TimeoutStartSec=30min

# Hardening
# User: create a dedicated account and replace root.
#   useradd --system --home /var/lib/backup-db --shell /usr/sbin/nologin backup-db
#   User=backup-db
#   Group=backup-db
# Do not set User=nobody. systemd-analyze reports that special user as unsafe.
User=root
Group=root
# NoNewPrivileges: the process cannot gain privileges through setuid or file capabilities.
NoNewPrivileges=yes
# ProtectSystem=strict: /usr, /boot, and /etc are read-only for this process.
# Write through StateDirectory, LogsDirectory, or ReadWritePaths.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
StateDirectory=backup-db
LogsDirectory=backup-db
ReadWritePaths=/var/lib/backup-db /var/log/backup-db /var/backups
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
